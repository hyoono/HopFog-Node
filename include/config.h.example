/*
 * Configuration Template for HopFog Node
 *
 * INSTRUCTIONS:
 * 1. Copy this file to config.h  (in the same include/ directory)
 * 2. Edit config.h with your actual values
 * 3. config.h is listed in .gitignore so it will not be committed
 *
 * Pin defaults differ per board and are set in main.cpp.
 * Override them here only if you wire things differently.
 */

// WiFi Configuration
#define WIFI_SSID     "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Node identity – each node must have a unique ID
#define NODE_ID "node-01"

// XBee serial baud rate
#define XBEE_BAUD 9600

// ── ESP32-CAM pin overrides (defaults: RX=13, TX=12) ───────────
// #define XBEE_RX_PIN 12
// #define XBEE_TX_PIN 13

// ── Wemos D1 Mini pin overrides (defaults: RX=D5/14, TX=D6/12) ─
// #define XBEE_RX_PIN 14
// #define XBEE_TX_PIN 12

// Web server port (default 80)
// #define WEB_SERVER_PORT 80

// Heartbeat interval in milliseconds (default 30 s)
// #define HEARTBEAT_INTERVAL_MS 30000

// Data sync interval in milliseconds (default 60 s)
// #define SYNC_INTERVAL_MS 60000

// Registration retry interval in milliseconds (default 10 s)
// Node retries REGISTER until admin responds with REGISTER_ACK
// #define REGISTER_RETRY_MS 10000

// ── WiFi Access Point (for mobile clients) ─────────────────────
// The node creates a WiFi hotspot so mobile phones can connect.
// A built-in DNS server resolves the domain to this node's IP,
// so the mobile app's BASE_URL (http://hopfog.com) works unchanged.
#define AP_SSID     "HopFog-Network"
#define AP_PASSWORD "hopfog123"
// #define AP_CHANNEL 6
// #define DNS_DOMAIN "hopfog.com"
