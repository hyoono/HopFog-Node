/*
 * Configuration Template for HopFog Node (ESP32-CAM)
 *
 * INSTRUCTIONS:
 * 1. Copy this file to config.h
 * 2. Edit config.h with your actual values
 * 3. config.h is listed in .gitignore so it will not be committed
 */

// WiFi Configuration
#define WIFI_SSID     "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Node identity – each node must have a unique ID
#define NODE_ID "node-01"

// XBee serial configuration
#define XBEE_BAUD   9600
#define XBEE_RX_PIN 32   // ESP32 GPIO that receives data FROM XBee TX
#define XBEE_TX_PIN 33   // ESP32 GPIO that sends data TO XBee RX

// Web server port (default 80)
// #define WEB_SERVER_PORT 80

// Heartbeat interval in milliseconds (default 30 s)
// #define HEARTBEAT_INTERVAL_MS 30000

// Data sync interval in milliseconds (default 60 s)
// #define SYNC_INTERVAL_MS 60000
